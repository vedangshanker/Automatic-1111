+
+                    model_hijack.embedding_db.load_textual_inversion_embeddings(force_reload=True)
+                    refreshes.append("embeddings")
+            except Exception as exc:
+                print_ly(f"Refresh failed for {file_path.name}: {exc}")
+
+        if refreshes:
+            print_lc(
+                f"Refreshed WebUI indexes after download: {', '.join(refreshes)}"
+            )
